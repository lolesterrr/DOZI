# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.
# Only EXPO_PUBLIC_* values are bundled into the app. Never put the Supabase service_role key here.

# Supabase (needed from Phase 3, task 3.1)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Alpha feedback form (task 2.10): a link to a Google Form (or similar) for testers.
# Must start with https://. Leave empty to hide "Send feedback" in Settings.
# For a shared preview APK, set the same value as an EAS environment variable (see docs/SETUP.md).
EXPO_PUBLIC_FEEDBACK_URL=
